//@version=6
indicator(title="[JL] Supertrend Zone Pivot Point with zigzag fib - Optimized Signals", overlay=true, max_labels_count=500, max_bars_back=4900)

// ==================== 显示控制 ====================
show_zigzag          = input.bool(true, "Show zigzag", group="Show")
show_fib             = input.bool(true, "Show fibonacci", group="Show")
show_supertrend      = input.bool(true, "Show supertrend", group="Show")
show_premiumdiscount = input.bool(true, "Show premium/discount line", group="Show")
show_signals         = input.bool(true, "Show Buy/Sell Signals", group="Show")

// ==================== Supertrend 参数 ====================
atrPeriod = input.int(10, "ATR Length", group="Supertrend")
factor    = input.float(3.0, "Factor", step=0.1, group="Supertrend")
atrline   = input.float(1.5, "Premium/Discount Multiplier", step=0.1, group="Supertrend")

// ==================== 信号优化参数 ====================
useRSI           = input.bool(true, "Use RSI Filter", group="Signal Filters")
rsiLen           = input.int(14, "RSI Length", group="Signal Filters")
rsiOB            = input.int(70, "RSI Overbought", group="Signal Filters")
rsiOS            = input.int(30, "RSI Oversold", group="Signal Filters")

useADX           = input.bool(true, "Use ADX Filter", group="Signal Filters")
adxLen           = input.int(14, "ADX Length", group="Signal Filters")
adxThresh        = input.float(20.0, "ADX Threshold", group="Signal Filters")

minBarsSinceTurn = input.int(3, "Min Bars since Trend Change", group="Signal Filters")
useHTF           = input.bool(false, "Use Higher Timeframe Supertrend Filter", group="Signal Filters")
htfTF            = input.timeframe("60", "Higher TF", group="Signal Filters")

// ==================== 颜色 ====================
textColorH  = input.color(color.white, "Pivot High Text", inline="Pivot High", group="Colors")
labelColorH = input.color(color.red, "", inline="Pivot High", group="Colors")
textColorL  = input.color(color.white, "Pivot Low Text", inline="Pivot Low", group="Colors")
labelColorL = input.color(color.green, "", inline="Pivot Low", group="Colors")

// ==================== Supertrend 计算 ====================
[supertrend, direction] = ta.supertrend(factor, atrPeriod)

bodyMiddle = plot((open + close) / 2, display=display.none)
upTrend    = plot(direction < 0 and show_supertrend ? supertrend : na, "Up Trend", color=color.green, style=plot.style_linebr)
downTrend  = plot(direction > 0 and show_supertrend ? supertrend : na, "Down Trend", color=color.red, style=plot.style_linebr)

fill(bodyMiddle, upTrend,   show_supertrend ? color.new(color.green, 90) : na, fillgaps=false)
fill(bodyMiddle, downTrend, show_supertrend ? color.new(color.red, 90) : na, fillgaps=false)

ATR       = ta.atr(atrPeriod)
upatrline = supertrend + atrline * ATR
dnatrline = supertrend - atrline * ATR

plot(direction < 0 and show_premiumdiscount ? upatrline : na, "Up ATR (Discount)", color=color.white, style=plot.style_linebr)
plot(direction > 0 and show_premiumdiscount ? dnatrline : na, "Dn ATR (Premium)",  color=color.white, style=plot.style_linebr)

// ==================== 趋势转折检测 ====================
turnGreen = ta.change(direction) < 0
turnRed   = ta.change(direction) > 0

barsturngreen = bar_index - ta.valuewhen(turnGreen, bar_index, 0)
barsturnred   = bar_index - ta.valuewhen(turnRed,   bar_index, 0)

barsg = barsturngreen > 0 ? barsturngreen : 1
barsr = barsturnred   > 0 ? barsturnred   : 1

h1 = ta.highest(high, barsg)
l2 = ta.lowest(low,   barsr)

// 关键修复：ta.change 转成布尔条件
barsh  = bar_index - ta.valuewhen(ta.change(h1) != 0, bar_index, 0)
barsl  = bar_index - ta.valuewhen(ta.change(l2) != 0, bar_index, 0)
barsh2 = bar_index - ta.valuewhen(ta.change(h1) != 0, bar_index, 1)
barsl2 = bar_index - ta.valuewhen(ta.change(l2) != 0, bar_index, 1)

// ==================== 枢轴标签 & Zigzag ====================
drawLabel(_offset, _pivot, _style, _color, _textColor) =>
    if not na(_pivot)
        label.new(bar_index - _offset, _pivot, str.tostring(_pivot, format.mintick), style=_style, color=_color, textcolor=_textColor)

var label h1label = na
var label l2label = na

if turnRed
    h1label := drawLabel(barsh, h1, label.style_label_down, labelColorH, textColorH)
    if show_zigzag
        line.new(bar_index - barsh, h1, bar_index - barsl2, l2[1], width=3, color=color.lime)

if turnGreen
    l2label := drawLabel(barsl, l2, label.style_label_up, labelColorL, textColorL)
    if show_zigzag
        line.new(bar_index - barsh2, h1[1], bar_index - barsl, l2, width=3, color=color.fuchsia)

hh = ta.valuewhen(turnRed,   h1, 0)
ll = ta.valuewhen(turnGreen, l2, 0)
mid_val = (hh + ll) / 2

// ==================== 斐波那契 ====================
var line hhLine = na
var line llLine = na
var line midline = na
var label fibLabelh = na
var label fibLabell = na
var label fibLabelm = na
var label fibLabel5 = na
var label fibLabel6 = na
var line fibLine5 = na
var line fibLine6 = na

if barstate.islast and show_fib and not na(hh) and not na(ll) and hh > ll
    h1Index = 0
    l2Index = 0

    while high[h1Index] != h1[1] and h1Index < 500
        h1Index += 1
    while low[l2Index] != l2[1] and l2Index < 500
        l2Index += 1

    n = math.max(h1Index, l2Index)

    // 删除旧对象
    if not na(hhLine)
        line.delete(hhLine)
    if not na(llLine)
        line.delete(llLine)
    if not na(midline)
        line.delete(midline)
    if not na(fibLabelh)
        label.delete(fibLabelh)
    if not na(fibLabell)
        label.delete(fibLabell)
    if not na(fibLabelm)
        label.delete(fibLabelm)
    if not na(fibLabel5)
        label.delete(fibLabel5)
    if not na(fibLabel6)
        label.delete(fibLabel6)
    if not na(fibLine5)
        line.delete(fibLine5)
    if not na(fibLine6)
        line.delete(fibLine6)

    // 0 和 1 水平
    hhLine := line.new(bar_index - n + 1, hh, bar_index, hh, color=color.purple, width=1)
    fibLabelh := label.new(bar_index + 10, hh, "1(" + str.tostring(hh) + ")", style=label.style_none, textcolor=color.gray)

    llLine := line.new(bar_index - n + 1, ll, bar_index, ll, color=color.purple, width=1)
    fibLabell := label.new(bar_index + 10, ll, "0(" + str.tostring(ll) + ")", style=label.style_none, textcolor=color.gray)

    midline := line.new(bar_index - n + 1, mid_val, bar_index, mid_val, color=color.purple, width=1)
    fibLabelm := label.new(bar_index + 10, mid_val, "0.5(" + str.tostring(mid_val) + ")", style=label.style_none, textcolor=color.gray)

    // 0.236 / 0.382 / 0.618 / 0.786
    ratios = array.from(0.236, 0.382, 0.618, 0.786)
    for i = 0 to 3
        ratio = array.get(ratios, i)
        y = ll + ratio * (hh - ll)
        line.new(bar_index - n + 1, y, bar_index, y, color=color.purple, width=1)
        label.new(bar_index + 10, y, str.tostring(ratio) + "(" + str.tostring(y, "#.####") + ")", style=label.style_none, textcolor=color.gray)

    // 扩展位
    if close > supertrend
        y = ll + 1.618 * (hh - ll)
        fibLine5 := line.new(bar_index - n + 1, y, bar_index, y, color=color.purple, width=1)
        fibLabel5 := label.new(bar_index + 10, y, "1.618(" + str.tostring(y, "#.####") + ")", style=label.style_none, textcolor=color.gray)

    if close < supertrend
        y = ll - 0.618 * (hh - ll)
        fibLine6 := line.new(bar_index - n + 1, y, bar_index, y, color=color.purple, width=1)
        fibLabel6 := label.new(bar_index + 10, y, "-0.618(" + str.tostring(y, "#.####") + ")", style=label.style_none, textcolor=color.gray)

// ==================== 信号过滤计算 ====================
rsi = ta.rsi(close, rsiLen)
[diplus, diminus, adx] = ta.dmi(adxLen, adxLen)

htfDir = request.security(syminfo.tickerid, htfTF, direction, barmerge.gaps_off, barmerge.lookahead_off)

// 折扣 / 溢价区
inDiscount = direction < 0 and close <= upatrline
inPremium  = direction > 0 and close >= dnatrline

// 信号条件（已规范括号）
longCond = direction < 0 and inDiscount and (not useRSI or (rsi < rsiOB and rsi > 40)) and (not useADX or adx > adxThresh) and barsturngreen >= minBarsSinceTurn and (not useHTF or htfDir < 0) and close > open

shortCond = direction > 0 and inPremium and (not useRSI or (rsi > rsiOS and rsi < 60)) and (not useADX or adx > adxThresh) and barsturnred >= minBarsSinceTurn and (not useHTF or htfDir > 0) and close < open

// 信号冷却
var bool longFired  = false
var bool shortFired = false

if turnGreen
    longFired := false
if turnRed
    shortFired := false

buySignal  = longCond and not longFired and show_signals
sellSignal = shortCond and not shortFired and show_signals

if buySignal
    longFired := true
if sellSignal
    shortFired := true

// ==================== 信号绘制 ====================
plotshape(buySignal,  title="Buy",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.normal, text="BUY")
plotshape(sellSignal, title="Sell", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.normal, text="SELL")

// ==================== 警报 ====================
alertcondition(buySignal,  title="Optimized Buy Signal",  message="[JL Optimized] Buy Signal on {{ticker}}")
alertcondition(sellSignal, title="Optimized Sell Signal", message="[JL Optimized] Sell Signal on {{ticker}}")
